# Node Environment
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth & Sockets
# Must be a strong, randomly generated string
JWT_SECRET=

# AES 256 GCM Secret for Phone Number Encryption
# Must be a strong, randomly generated 32-byte string
AES_SECRET_KEY=

# VAPID Keys for Web Push Notifications
# Generate these using `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@yourdomain.com"
